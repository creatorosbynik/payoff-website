---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url><loc>{{ site.url }}/</loc><lastmod>{{ build.date | isoDate | truncate(10, true, "") }}</lastmod><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/blog/</loc>{% if collections.posts.length %}<lastmod>{{ collections.posts[0].date | isoDate | truncate(10, true, "") }}</lastmod>{% endif %}<changefreq>daily</changefreq><priority>0.9</priority></url>
  {%- for c in collections.categoryPages %}
  <url><loc>{{ site.url }}/blog/category/{{ c.slug }}/</loc><changefreq>weekly</changefreq><priority>0.5</priority></url>
  {%- endfor %}
  {%- for p in collections.posts %}
  <url><loc>{{ p.url | absoluteUrl(site.url) }}</loc><lastmod>{{ (p.data.updated or p.date) | isoDate | truncate(10, true, "") }}</lastmod><changefreq>monthly</changefreq><priority>0.8</priority>{% if p.data.cover %}<image:image><image:loc>{{ p.data.cover | absoluteUrl(site.url) }}</image:loc></image:image>{% endif %}</url>
  {%- endfor %}
  <url><loc>{{ site.url }}/privacy.html</loc><changefreq>yearly</changefreq><priority>0.3</priority></url>
  <url><loc>{{ site.url }}/terms.html</loc><changefreq>yearly</changefreq><priority>0.3</priority></url>
</urlset>
