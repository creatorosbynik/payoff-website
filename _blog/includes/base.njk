<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ seo_title | escape }}</title>
<meta name="description" content="{{ seo_desc | escape }}">
<link rel="canonical" href="{{ seo_canonical }}">
<meta name="robots" content="{{ 'noindex, follow' if seo_noindex else 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
<meta name="theme-color" content="#0B0806">
<meta property="og:site_name" content="Payoff Creative">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:type" content="{{ seo_type or 'website' }}">
<meta property="og:title" content="{{ seo_og_title or seo_title }}">
<meta property="og:description" content="{{ seo_desc }}">
<meta property="og:url" content="{{ seo_canonical }}">
<meta property="og:image" content="{{ seo_image }}">
<meta property="og:image:width" content="1200">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_og_title or seo_title }}">
<meta name="twitter:description" content="{{ seo_desc }}">
<meta name="twitter:image" content="{{ seo_image }}">
{% block head_extra %}{% endblock %}
<link rel="alternate" type="application/rss+xml" title="{{ settings.blog_title }}" href="/blog/feed.xml">
<link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400..800&family=Fraunces:ital,opsz,wght@1,9..144,300..500&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@500&display=swap">
<link rel="stylesheet" href="/blog/assets/blog.css?v={{ build.version }}">
<link rel="stylesheet" href="/css/agency.css?v={{ build.version }}">
<link rel="stylesheet" href="/css/studio.css?v={{ build.version }}">
{% block jsonld %}{% endblock %}
</head>
<body class="{{ body_class }}">
<a class="skip" href="#main">Skip to content</a>
<header class="bn" id="bn">
  <a class="bn-logo" href="/" aria-label="Payoff home"><img src="/logo-cream.png" alt="Payoff" width="640" height="145" eleventy:ignore></a>
  {% if not focus_mode %}
  <nav class="bn-links" aria-label="Main">
    <a href="/work/"{% if page.url == "/work/" %} aria-current="page"{% endif %}>Work</a><a href="/#services">Services</a><a href="/remote-creative-services/">Remote</a><a href="/about/">About</a><a href="/blog/"{% if page.url and page.url.startsWith('/blog/') %} aria-current="page"{% endif %}>Blog</a>
  </nav>
  {% endif %}
  <div class="bn-r">
    {% if not focus_mode %}<details class="bn-menu"><summary>Menu</summary><nav aria-label="Mobile navigation"><a href="/work/">Work</a><a href="/#services">Services</a><a href="/remote-creative-services/">Remote creative partner</a><a href="/about/">About</a><a href="/blog/">Blog</a><a href="/contact/">Send a brief</a><a href="/#teardown">Free teardown</a></nav></details>{% endif %}
    <a class="btn" href="{{ header_cta_link or '/#teardown' }}">{{ header_cta_label or 'Get my teardown' }}</a>
  </div>
</header>

<main id="main">
{% block main %}{% endblock %}
</main>

<footer class="bf">
  <div class="bf-grid">
    <div>
      <img class="bf-logo" src="/logo-cream.png" alt="Payoff" width="640" height="145" loading="lazy" eleventy:ignore>
      <p class="bf-note">Payoff is a story-led creative agency in Noida, India. We find the story, or join your team to make it. Films, ads, editing, motion and creative support for brands and agencies worldwide.</p>
    </div>
    <div>
      <h2 class="mono">The blog</h2>
      <ul>
        <li><a href="/blog/">All posts</a></li>
        {% for c in collections.categoryPages %}<li><a href="/blog/category/{{ c.slug }}/">{{ c.name }}</a></li>{% endfor %}
        <li><a href="/blog/feed.xml">RSS feed</a></li>
        <li><a href="/about/">About Payoff</a></li>
        <li><a href="/work/">Explore the work</a></li>
      </ul>
    </div>
    <div>
      <h2 class="mono">Contact</h2>
      <ul>
        <li><a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp +91 88267 74234</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="/contact/">Have a brief? Send it →</a></li>
        <li><a href="/#teardown">Need direction? Free teardown →</a></li>
        <li><a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a> · <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="/privacy.html">Privacy</a> · <a href="/terms.html">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="core-footer-links"><h2 class="mono">From story to screen</h2><div class="core-link-row">{% for service in agency.services %}<a href="{{ service.url }}">{{ service.name }}</a>{% endfor %}</div></div>
  <p class="bf-sign" aria-hidden="true">Every story earns.</p>
  <p class="bf-tiny">© {{ build.year }} Payoff. Made in Noida.</p>
</footer>
{% block after %}{% endblock %}
<script src="/blog/assets/blog.js?v={{ build.version }}" defer></script>
<script src="/js/agency.js?v={{ build.version }}" defer></script>
<script src="/js/studio.js?v={{ build.version }}" defer></script>
</body>
</html>

