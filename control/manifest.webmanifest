{
  "name": "Payoff Control",
  "short_name": "Payoff",
  "description": "Daily stories, content calendar, leads and automations for Payoff.",
  "id": "/control/",
  "start_url": "/control/#/today",
  "scope": "/control/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0B0806",
  "theme_color": "#0B0806",
  "icons": [
    { "src": "/control/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/control/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/control/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/control/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/control/#/today" },
    { "name": "Leads", "url": "/control/#/leads" },
    { "name": "Calendar", "url": "/control/#/calendar" }
  ]
}
